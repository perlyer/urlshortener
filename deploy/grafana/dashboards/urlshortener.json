{
  "uid": "urlshortener",
  "title": "urlshortener",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS по сервису",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total[1m])) by (service)", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency редиректа (перцентили, сек)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"redirector\"}[1m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"redirector\"}[1m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"redirector\"}[1m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Создание ссылок: 201 vs 429",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{service=\"api\", route=\"/api/links\"}[1m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Редиректы по статусу",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{service=\"redirector\"}[1m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Кэш: попадания vs промахи (оп/сек)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(cache_operations_total[1m])) by (result)", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cache hit rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 }
          ] }
        }, "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(cache_operations_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_operations_total[5m])), 1)" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Rate-limit: доля отклонённых",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "orange", "value": 0.8 }
          ] }
        }, "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{service=\"api\", route=\"/api/links\", status=\"429\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"api\", route=\"/api/links\"}[5m])), 0.001)" }
      ]
    }
  ]
}
